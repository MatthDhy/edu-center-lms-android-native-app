<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Header cố định phía trên, form cuộn ở dưới -->
    <include layout="@layout/layout_child_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Mật khẩu hiện tại -->
            <TextView
                style="@style/Widget.App.FieldLabel"
                android:text="Mật khẩu hiện tại" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCurrent"
                style="@style/Widget.App.FormField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="#F1EDFB"
                app:endIconMode="password_toggle"
                app:errorIconDrawable="@null">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập mật khẩu hiện tại"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mật khẩu mới -->
            <TextView
                style="@style/Widget.App.FieldLabel"
                android:text="Mật khẩu mới" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNew"
                style="@style/Widget.App.FormField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="#F1EDFB"
                app:endIconMode="password_toggle"
                app:errorIconDrawable="@null">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập mật khẩu mới"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Thanh đo độ mạnh: 4 đoạn, tô màu bằng code -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/seg1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round_12"
                    android:backgroundTint="#E5E7EB" />

                <View
                    android:id="@+id/seg2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round_12"
                    android:backgroundTint="#E5E7EB" />

                <View
                    android:id="@+id/seg3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round_12"
                    android:backgroundTint="#E5E7EB" />

                <View
                    android:id="@+id/seg4"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round_12"
                    android:backgroundTint="#E5E7EB" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_semibold"
                android:textSize="11sp"
                android:visibility="invisible" />

            <!-- Hộp yêu cầu mật khẩu: các dòng đổi màu khi đạt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_round_12"
                android:backgroundTint="#FFF6D6"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvReqLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#92400E"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReqUpper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#92400E"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReqLower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#92400E"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Xác nhận mật khẩu mới -->
            <TextView
                style="@style/Widget.App.FieldLabel"
                android:text="Xác nhận mật khẩu mới" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirm"
                style="@style/Widget.App.FormField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="#F1EDFB"
                app:endIconMode="password_toggle"
                app:errorIconDrawable="@null">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nhập lại mật khẩu mới"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Lưu mật khẩu mới"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:backgroundTint="#3B2A78"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>