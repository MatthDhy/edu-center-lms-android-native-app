<?xml version="1.0" encoding="utf-8"?>
<!-- Header dùng chung cho các màn con: nút quay lại + tiêu đề.
     Dùng bằng: <include layout="@layout/layout_child_header" />
     rồi gọi ChildHeader.bind(...) trong Fragment để gắn tiêu đề và nút quay lại. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/childHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_child_header"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle"
        android:clickable="true"
        android:contentDescription="Quay lại"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="#3B2A78" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/inter_bold"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />
</LinearLayout>