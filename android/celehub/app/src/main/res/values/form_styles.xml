<?xml version="1.0" encoding="utf-8"?>
<!-- Đặt vào res/values/form_styles.xml -->
<resources>
    <!-- Ô nhập dùng trên nền trắng: có viền nhạt, viền tím khi focus.
         Kế thừa Widget.App.LoginField đã tạo trước đó trong login_styles.xml -->
    <style name="Widget.App.FormField" parent="Widget.App.LoginField">
        <item name="boxStrokeColor">@color/form_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
    </style>

    <!-- Chữ nhãn nhỏ nằm trên mỗi ô nhập -->
    <style name="Widget.App.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">#4B5563</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>