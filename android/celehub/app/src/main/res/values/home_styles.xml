<?xml version="1.0" encoding="utf-8"?>
<!-- Đặt vào res/values/home_styles.xml -->
<resources>
    <!-- Một ô chức năng (Điểm danh, Học phí...) -->
    <style name="Widget.App.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_round_16</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Chữ dưới icon của ô chức năng -->
    <style name="Widget.App.TileLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">#1E1B4B</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Tiêu đề mỗi mục (Bài tập sắp đến hạn, Thông báo mới) -->
    <style name="Widget.App.SectionTitle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textColor">#1E1B4B</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Chữ "Xem tất cả" bên phải tiêu đề -->
    <style name="Widget.App.SectionAction" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:padding">4dp</item>
        <item name="android:textColor">#7B61F0</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>