<?xml version="1.0" encoding="utf-8"?>
<!-- Đặt vào res/values/profile_styles.xml -->
<resources>
    <!-- Chữ nhỏ viết hoa đứng trên mỗi nhóm: TÀI KHOẢN, ỨNG DỤNG, HỖ TRỢ -->
    <style name="Widget.App.GroupLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">#6B7280</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Khung chứa các dòng của một nhóm, có đường kẻ giữa các dòng -->
    <style name="Widget.App.SettingGroup" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">@drawable/bg_setting_group</item>
        <item name="android:divider">@drawable/divider_setting</item>
        <item name="android:orientation">vertical</item>
        <item name="android:showDividers">middle</item>
    </style>
</resources>